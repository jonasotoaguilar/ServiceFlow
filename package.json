{
  "name": "Service-system",
  "version": "2.2.1",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "docker compose up -d --wait pocketbase && docker compose up pocketbase-init && next dev",
    "dev:stack": "docker compose -f compose.yaml -f compose.dev.yaml up",
    "build": "next build",
    "start": "next start",
    "check": "biome check --formatter-enabled=false .",
    "check:fix": "biome lint --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "test:mutate": "stryker run",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": "biome lint --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@tailwindcss/postcss": "^4.1.18",
    "boneyard-js": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "next": "^16.0.10",
    "pocketbase": "^0.28.0",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.1",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "husky": "9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "17.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
