# PocketBase — app locator (Next.js reads only this)
POCKETBASE_URL=http://127.0.0.1:8090

# Compose host ports — change to run multiple worktrees in parallel
# Defaults preserve zero-config single-worktree usage.
APP_PORT=3000
POCKETBASE_PORT=8090

# Local compose only — PocketBase superuser (never read by Next.js)
# The app container does NOT receive these; only pocketbase + pocketbase-init do.
# Override in a local .env (gitignored) if you need custom credentials.
POCKETBASE_ADMIN_EMAIL=admin@local.test
POCKETBASE_ADMIN_PASSWORD=admin123456

# Verification mail (pocketbase-init only — never the Next app).
# Absent/empty PB_SMTP_PASSWORD skips SMTP settings so default/local runs work.
# Set it (Resend API key) to apply Resend SMTP + sender/origin settings.
PB_SMTP_PASSWORD=
# Optional override for the verification link origin.
# Default: https://serviceflow.jonasotoaguilar.space
PB_META_APP_URL=
